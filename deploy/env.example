# Secrets and per-device overrides for Measure Station.
# Installed to /etc/measure-station/env (mode 0640, readable by the service only).
# Any MEASURE_STATION_* variable read in sysconfig.py can be set here.

#MEASURE_STATION_STATION_ID=station-01
#MEASURE_STATION_MQTT_HOST=broker.example.com
#MEASURE_STATION_MQTT_PORT=1883
#MEASURE_STATION_MQTT_USERNAME=
#MEASURE_STATION_MQTT_PASSWORD=
